---
import { demoMoney, demoParcel, formatPKR } from '../../data/demo';
import { withBase } from '../../utils/withBase';
---

<section class="money section section--kraft" id="money-flow">
  <div class="container">
    <div class="money-header">
      <h2 class="money-title lines">
        <span class="line"><span data-line style="--i:0">See where every</span></span>
        <span class="line"><span data-line style="--i:1">rupee goes.</span></span>
      </h2>
      <p class="money-subtitle" data-reveal style="--i:3">Clear rules for every payment. No surprises.</p>
    </div>

    <div class="money-grid">
      <!-- Sender side -->
      <div class="ledger-card" data-reveal style="--i:0">
        <div class="ledger-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="M2 10h20"/></svg>
          <span>Sender pays</span>
        </div>
        <div class="ledger-body">
          <div class="ledger-row">
            <span class="ledger-label">Carrying amount</span>
            <span class="ledger-amount">{formatPKR(demoMoney.senderCarryingAmount)}</span>
          </div>
          <div class="ledger-divider"></div>
          <div class="ledger-row">
            <span class="ledger-label">Sender transfers</span>
            <span class="ledger-amount ledger-amount--bold">{formatPKR(demoMoney.senderCarryingAmount)}</span>
          </div>
          <div class="ledger-status">
            <div class="status-step">
              <span class="status-dot status-dot--done"></span>
              <span>Payment submitted</span>
            </div>
            <div class="status-step">
              <span class="status-dot status-dot--done"></span>
              <span>Khepia verifies</span>
            </div>
            <div class="status-step">
              <span class="status-dot status-dot--active"></span>
              <span>Payment held</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Passenger side -->
      <div class="ledger-card" data-reveal style="--i:1">
        <div class="ledger-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.8 19.2L16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
          <span>Passenger pays</span>
        </div>
        <div class="ledger-body">
          <div class="ledger-row">
            <span class="ledger-label">Refundable deposit (declared value)</span>
            <span class="ledger-amount">{formatPKR(demoMoney.passengerDeposit)}</span>
          </div>
          <div class="ledger-row">
            <span class="ledger-label">Khepia commission (10%)</span>
            <span class="ledger-amount">{formatPKR(demoMoney.commission)}</span>
          </div>
          <div class="ledger-divider"></div>
          <div class="ledger-row">
            <span class="ledger-label">Passenger transfers</span>
            <span class="ledger-amount ledger-amount--bold">{formatPKR(demoMoney.passengerUpfront)}</span>
          </div>
          <div class="ledger-breakdown">
            <span>{formatPKR(demoMoney.passengerDeposit)} refundable deposit</span>
            <span>{formatPKR(demoMoney.commission)} Khepia commission</span>
          </div>
        </div>
      </div>

      <!-- After delivery -->
      <div class="ledger-card ledger-card--result" data-reveal style="--i:2">
        <div class="ledger-header ledger-header--ok">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
          <span>After successful delivery</span>
        </div>
        <div class="ledger-body">
          <div class="ledger-row">
            <span class="ledger-label">Deposit returned to passenger</span>
            <span class="ledger-amount ledger-amount--ok">{formatPKR(demoMoney.passengerDeposit)}</span>
          </div>
          <div class="ledger-row">
            <span class="ledger-label">Net carrying earning</span>
            <span class="ledger-amount ledger-amount--ok">{formatPKR(demoMoney.passengerNetEarning)}</span>
          </div>
          <div class="ledger-divider"></div>
          <div class="ledger-row">
            <span class="ledger-label">Total released to passenger</span>
            <span class="ledger-amount ledger-amount--bold ledger-amount--ok">{formatPKR(demoMoney.passengerCompletionRelease)}</span>
          </div>
          <div class="ledger-divider"></div>
          <div class="ledger-row">
            <span class="ledger-label">Khepia retains</span>
            <span class="ledger-amount">{formatPKR(demoMoney.khepiaRetains)}</span>
          </div>
        </div>
        <p class="ledger-note">Example values only</p>
      </div>
    </div>
  </div>
</section>

<!-- Deposit explainer -->
<section class="deposit section section--deep" id="deposit">
  <div class="container">
    <div class="deposit-head">
      <h3 class="deposit-title" data-reveal>Why does the traveller deposit the parcel value?</h3>
      <div class="deposit-copy" data-reveal style="--i:2">
        <p class="deposit-explanation">
          The Deposit equals the Declared Value. Khepia holds it as security for the Passenger’s performance (and for any Parcel Protection under the Terms). On Completion it is returned with the Delivery Fee within 5 Working Days. Sender pays the Delivery Fee first; then the Passenger pays Deposit + 10% Commission.
        </p>
        <p class="deposit-link">
          <a href={withBase("payments-refunds")}>Payments &amp; refunds</a>
          ·
          <a href={withBase("terms#clause-13")}>Full Terms</a>
        </p>
      </div>
    </div>

    <div class="deposit-visual">
      <div class="deposit-step" data-reveal style="--i:0">
        <span class="deposit-label">Parcel declared value</span>
        <span class="deposit-value">{formatPKR(demoParcel.declaredValue)}</span>
      </div>
      <svg class="deposit-arrow" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
      <div class="deposit-step" data-reveal style="--i:1">
        <span class="deposit-label">Refundable deposit</span>
        <span class="deposit-value">{formatPKR(demoParcel.declaredValue)}</span>
      </div>
      <svg class="deposit-arrow" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
      <div class="deposit-step deposit-step--ok" data-reveal style="--i:2">
        <span class="deposit-label">After confirmed delivery</span>
        <span class="deposit-value deposit-value--ok">{formatPKR(demoParcel.declaredValue)} returned</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Money (kraft field, paper receipts) ─────────────── */
  .money-header {
    display: grid;
    gap: var(--space-6);
    margin-bottom: clamp(40px, 6vw, 80px);
  }

  .money-title {
    font-size: var(--text-h2);
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--deep);
  }

  .money-subtitle {
    font-size: var(--text-lg);
    color: var(--deep);
    max-width: 20em;
  }

  @media (min-width: 900px) {
    .money-header {
      grid-template-columns: 1fr auto;
      align-items: end;
      column-gap: var(--space-16);
    }
  }

  .money-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  @media (min-width: 768px) {
    .money-grid { grid-template-columns: 1fr 1fr; }
    .ledger-card--result { grid-column: 1 / -1; }
  }

  @media (min-width: 1100px) {
    .money-grid { grid-template-columns: 1fr 1fr 1fr; }
    .ledger-card--result { grid-column: auto; }
    .ledger-card:nth-child(2) { margin-top: var(--space-12); }
    .ledger-card:nth-child(3) { margin-top: var(--space-24); }
  }

  /* Receipt: flat paper, torn bottom edge */
  .ledger-card {
    background: #fff;
    color: var(--text);
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    padding-bottom: 14px;
    mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 22px 100%; /* taste-skill-ignore: torn receipt edge */
    -webkit-mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 22px 100%; /* taste-skill-ignore: torn receipt edge */
  }

  .ledger-card--result {
    background: var(--deep);
    color: #fff;
  }

  .ledger-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-6) 0;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--navy);
  }
  .ledger-header--ok { color: var(--ok-on-dark); }

  .ledger-body {
    padding: var(--space-5) var(--space-6) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .ledger-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
  }

  .ledger-label {
    font-size: var(--text-label);
    color: var(--text-2);
  }
  .ledger-card--result .ledger-label { color: var(--text-on-dark-2); }

  .ledger-amount {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--text);
  }
  .ledger-card--result .ledger-amount { color: #fff; }

  .ledger-amount--bold {
    font-size: var(--text-card);
    font-weight: var(--weight-extrabold);
    letter-spacing: -0.03em;
  }
  .ledger-card--result .ledger-amount--ok { color: var(--ok-on-dark); }

  .ledger-divider {
    border-top: 2px dashed color-mix(in srgb, currentColor 22%, transparent);
  }

  .ledger-breakdown {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--text-xs);
    color: var(--text-2);
  }

  .ledger-note {
    padding: 0 var(--space-6) var(--space-4);
    font-size: var(--text-xs);
    color: var(--text-on-dark-muted);
  }

  .ledger-status {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .status-step {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-2);
  }

  .status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .status-dot--done   { background: var(--ink-200); }
  .status-dot--active { background: var(--ok); }

  /* ── Deposit (deep field) ────────────────────────────── */
  .deposit-head {
    display: grid;
    gap: var(--space-8);
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  .deposit-title {
    font-size: var(--text-h1);
    letter-spacing: -0.045em;
    line-height: 1;
    max-width: 14em;
  }

  .deposit-explanation {
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-5);
  }

  .deposit-link {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-on-dark-2);
  }
  .deposit-link a {
    color: #fff;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    text-decoration-color: var(--kraft);
  }

  @media (min-width: 1024px) {
    .deposit-head {
      grid-template-columns: 1.1fr 0.9fr;
      column-gap: var(--space-24);
      align-items: end;
    }
  }

  .deposit-visual {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    align-items: stretch;
  }

  .deposit-step {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    background: rgba(255, 255, 255, 0.07);
  }
  .deposit-step--ok { background: var(--ok-on-dark); color: var(--deep); }

  .deposit-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
  }
  .deposit-step--ok .deposit-label { color: var(--deep); opacity: 0.75; }

  .deposit-value {
    font-size: var(--text-h3);
    font-weight: var(--weight-extrabold);
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: #fff;
  }
  .deposit-value--ok { color: var(--deep); }

  .deposit-arrow { display: none; color: var(--kraft); justify-self: center; }

  @media (min-width: 1024px) {
    .deposit-visual {
      grid-template-columns: 1fr auto 1fr auto 1fr;
      align-items: center;
      column-gap: var(--space-6);
    }
    .deposit-arrow { display: block; }
  }
</style>
