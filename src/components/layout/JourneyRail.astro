---
// Page progress as a flight: Dubai at the top, Rawalpindi at the bottom.
// Scroll progress is written to one CSS variable (--p); the fill and the dot
// only transform from it. Plain scroll listener, works in every browser and
// regardless of reduced-motion settings (it is a position indicator, not an animation).
---

<div class="rail" aria-hidden="true">
  <span class="rail-code">DXB</span>
  <span class="rail-track">
    <span class="rail-fill"></span>
    <span class="rail-dot"></span>
  </span>
  <span class="rail-code">RWP</span>
</div>

<script>
  const rail = document.querySelector<HTMLElement>('.rail');
  if (rail) {
    let queued = false;
    const update = () => {
      queued = false;
      const max = document.documentElement.scrollHeight - innerHeight;
      const p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
      rail.style.setProperty('--p', p.toFixed(4));
    };
    const queue = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    update();
  }
</script>

<style>
  .rail {
    --rail-h: min(36vh, 340px);
    display: none;
    position: fixed;
    right: 20px;
    top: 50%;
    z-index: var(--z-sticky);
    translate: 0 -50%;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    width: 52px;
    padding: var(--space-4) 0;
    border-radius: var(--radius-full);
    background: #fff;
    box-shadow: 0 4px 24px rgba(15, 18, 56, 0.16); /* taste-skill-ignore: fixed overlay over mixed fields */
  }

  .rail-code {
    font-size: 0.75rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.01em;
    color: var(--navy);
  }

  .rail-track {
    position: relative;
    width: 3px;
    height: var(--rail-h);
    border-radius: 3px;
    background: var(--ink-100);
  }

  .rail-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--navy);
    transform: scaleY(var(--p, 0));
    transform-origin: top;
  }

  .rail-dot {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateY(calc(var(--rail-h) * var(--p, 0)));
    box-sizing: content-box;
    width: 14px;
    height: 14px;
    margin: -10px 0 0 -10px;
    border-radius: 4px;
    background: var(--kraft);
    border: 3px solid #fff;
  }

  @media (min-width: 1100px) {
    .rail { display: flex; }
  }
</style>
