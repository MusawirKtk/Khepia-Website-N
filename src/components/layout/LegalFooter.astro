---
import { withBase } from "../../utils/withBase";

const footerSections = [
  {
    title: "Product",
    links: [
      { label: "How it works", href: withBase("#how-it-works") },
      { label: "Send & carry", href: withBase("#sender") },
      { label: "Payments", href: withBase("#money-flow") },
      { label: "Training", href: withBase("#training") },
    ],
  },
  {
    title: "Trust & Safety",
    links: [
      { label: "Safety", href: withBase("#safety") },
      { label: "Prohibited items", href: withBase("prohibited-items") },
      { label: "Customs", href: withBase("customs-and-liability") },
      { label: "Payments and refunds", href: withBase("payments-refunds") },
    ],
  },
  {
    title: "Support",
    links: [
      { label: "WhatsApp", href: "https://wa.me/0000000000" },
      { label: "Email", href: "mailto:khepia.pk@gmail.com" },
      { label: "FAQ", href: withBase("#faq") },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Terms and Conditions", href: withBase("terms") },
      { label: "Privacy Policy", href: withBase("privacy") },
    ],
  },
];

const currentYear = new Date().getFullYear();
---

<footer class="footer section section--deep">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand column -->
      <div class="footer-brand">
        <a href={withBase()} class="footer-logo" aria-label="Khepia home">
          <svg class="logo-mark" width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect width="32" height="32" rx="8" fill="currentColor" opacity="0.15"/>
            <path d="M8 24V8h4v6.5L17.5 8H22l-6.5 7.5L22 24h-4.5l-4-6.2L12 19v5H8z" fill="currentColor"/>
          </svg>
          <span class="footer-logo-text">Khepia</span>
        </a>
        <p class="footer-tagline">
          Send with someone already going.
        </p>
        <p class="footer-corridor">
          UAE · Saudi Arabia · Pakistan
        </p>
      </div>

      <!-- Link columns -->
      {footerSections.map((section) => (
        <div class="footer-column">
          <h4 class="footer-column-title">{section.title}</h4>
          <ul class="footer-links">
            {section.links.map((link) => (
              <li>
                <a href={link.href} class="footer-link">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Security message -->
    <div class="footer-security">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
      <p>Khepia will never ask you to share your password, OTP, or verification code over WhatsApp, email, or phone.</p>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p class="footer-copyright">
        © {currentYear} Khepia. All rights reserved.
      </p>
    </div>
  </div>

  <!-- Giant wordmark, cropped by the page edge -->
  <div class="footer-wordmark" aria-hidden="true">Khepia</div>
</footer>

<style>
  .footer {
    padding-block: var(--space-16) 0;
    overflow: clip;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }

  @media (min-width: 640px) {
    .footer-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.5fr repeat(4, 1fr);
      gap: var(--space-12);
    }
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-on-dark);
    margin-bottom: var(--space-4);
  }

  .footer-logo-text {
    font-size: 1.5rem;
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.02em;
    font-variant-numeric: lining-nums;
  }

  .footer-tagline {
    font-size: var(--text-sm);
    margin-bottom: var(--space-2);
  }

  .footer-corridor {
    font-size: var(--text-label);
    color: var(--text-on-dark-muted);
    letter-spacing: 0.04em;
  }

  .footer-column-title {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--kraft);
    letter-spacing: 0.01em;
    margin-bottom: var(--space-4);
  }

  .footer-links { display: flex; flex-direction: column; gap: var(--space-3); }

  .footer-link {
    display: inline-block;
    padding-block: 2px;
    font-size: var(--text-sm);
    color: var(--text-on-dark-2);
    transition: color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer-link:hover { color: #fff; }
  }

  .footer-security {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-top: var(--space-12);
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-lg);
    background-color: rgba(255, 255, 255, 0.06);
  }

  .footer-security svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--kraft);
  }

  .footer-security p {
    font-size: var(--text-label);
    color: var(--text-on-dark-2);
    line-height: var(--leading-normal);
  }

  .footer-bottom { margin-top: var(--space-10); }

  .footer-copyright {
    font-size: var(--text-xs);
    color: var(--text-on-dark-muted);
  }

  .footer-wordmark {
    margin-top: var(--space-8);
    margin-bottom: -0.2em;
    text-align: center;
    font-size: clamp(6rem, 29vw, 28rem);
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    letter-spacing: -0.02em;
    font-variant-numeric: lining-nums;
    line-height: 0.8;
    color: rgba(255, 255, 255, 0.07);
    user-select: none;
    pointer-events: none;
    white-space: nowrap;
  }
</style>
