---
import { trainingVideo } from '../../data/training';
import { withBase } from '../../utils/withBase';

const video = trainingVideo;
const posterUrl = `https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`;
const embedSrc = `https://www.youtube-nocookie.com/embed/${video.youtubeId}?autoplay=1&rel=0&modestbranding=1`;
const secondaryHref = video.secondaryCta
  ? withBase(video.secondaryCta.href)
  : undefined;
---

<section class="training section section--white" id="training">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title lines">
        <span class="line"><span data-line style="--i:0">Know how Khepia works</span></span>
        <span class="line"><span data-line style="--i:1">before you use it.</span></span>
      </h2>
      <p class="section-subtitle" data-reveal style="--i:3">One short training covers sending and carrying. Confirm you've watched it in the app before you post.</p>
    </div>

    <div class="training-card">
      <div
        class="training-player"
        id="training-player"
        data-embed-src={embedSrc}
        data-reveal
      >
        <img
          class="training-poster-img"
          src={posterUrl}
          alt=""
          width="480"
          height="360"
          loading="lazy"
          decoding="async"
        />
        <button
          type="button"
          class="play-btn"
          id="training-play-btn"
          aria-label={`Play ${video.title}`}
        >
          <span class="play-disc">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="7 3 20 12 7 21"/></svg>
          </span>
        </button>
        <span class="poster-duration">{video.duration}</span>
      </div>

      <div class="training-content" data-reveal style="--i:2">
        <span class="training-label">{video.subtitle}</span>
        <h3 class="training-title">{video.title}</h3>
        <p class="training-desc">{video.description}</p>

        <details class="chapters-accordion">
          <summary class="chapters-toggle">
            <span>Chapters</span>
            <svg class="chapters-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <ol class="chapters-list">
            {video.chapters.map((chapter) => (
              <li class="chapter-item">
                <span class="chapter-time">{chapter.time}</span>
                <span class="chapter-label">{chapter.label}</span>
              </li>
            ))}
          </ol>
        </details>

        <div class="training-ctas">
          <button type="button" class="btn btn--primary" id="training-cta-play">
            {video.ctaLabel}
          </button>
          {video.secondaryCta && secondaryHref && (
            <a href={secondaryHref} class="btn btn--secondary">
              {video.secondaryCta.label}
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-header {
    display: grid;
    gap: var(--space-6);
    margin-bottom: clamp(40px, 6vw, 80px);
  }

  .section-title {
    font-size: var(--text-h2);
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--navy);
  }

  .section-subtitle {
    font-size: var(--text-lg);
    max-width: 28em;
  }

  .training-card {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .training-card {
      grid-template-columns: 1.35fr 1fr;
      column-gap: var(--space-16);
    }
  }

  /* Always 16:9 — YouTube embed must not stretch with side content */
  .training-player {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--navy);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .training-poster-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .training-player :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .play-btn {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    background: rgba(15, 18, 56, 0.28);
  }

  .play-disc {
    display: grid;
    place-items: center;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: var(--kraft);
    color: var(--deep);
    transition: transform 320ms var(--ease-out);
  }
  .play-disc svg { margin-left: 4px; }
  .play-btn:active .play-disc { transform: scale(0.94); }

  @media (hover: hover) and (pointer: fine) {
    .play-btn:hover .play-disc { transform: scale(1.08); }
    .play-btn:active .play-disc { transform: scale(0.97); }
  }

  .poster-duration {
    position: absolute;
    bottom: var(--space-4);
    right: var(--space-4);
    z-index: 1;
    padding: 2px var(--space-3);
    border-radius: var(--radius-full);
    background: var(--deep);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .training-player.is-playing .play-btn,
  .training-player.is-playing .poster-duration,
  .training-player.is-playing .training-poster-img {
    display: none;
  }

  .training-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .training-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--navy);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .training-title {
    font-size: var(--text-h3);
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .training-desc { font-size: var(--text-body); }

  /* ── Chapters: height animates open and closed ───────── */
  .chapters-accordion {
    border-radius: var(--radius-lg);
    background: var(--paper);
    padding: 0 var(--space-5);
  }

  .chapters-accordion::details-content {
    block-size: 0;
    overflow: hidden;
    transition: block-size 340ms var(--ease-out), content-visibility 340ms allow-discrete;
  }
  .chapters-accordion[open]::details-content { block-size: auto; }

  .chapters-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--navy);
    cursor: pointer;
    list-style: none;
  }
  .chapters-toggle::-webkit-details-marker { display: none; }

  .chapters-chevron { transition: transform 320ms var(--ease-out); }
  details[open] .chapters-chevron { transform: rotate(180deg); }

  .chapters-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-bottom: var(--space-5);
  }

  .chapter-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    font-size: var(--text-label);
    color: var(--text);
  }

  .chapter-time {
    flex-shrink: 0;
    min-width: 44px;
    font-variant-numeric: tabular-nums;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--ink-400);
  }

  .training-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }
</style>

<script>
  const player = document.getElementById('training-player');
  if (player) {
    const embedSrc = player.getAttribute('data-embed-src');
    let started = false;

    function startTrainingVideo() {
      if (started || !embedSrc) return;
      started = true;

      const iframe = document.createElement('iframe');
      iframe.src = embedSrc;
      iframe.title = 'Khepia training video';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';

      player.classList.add('is-playing');
      player.appendChild(iframe);
    }

    document.getElementById('training-play-btn')?.addEventListener('click', startTrainingVideo);
    document.getElementById('training-cta-play')?.addEventListener('click', startTrainingVideo);
  }
</script>
