---
---

<section class="roles section section--navy" id="sender" data-role="sender">
  <!-- #carry lands here too — same section covers both modes -->
  <div id="carry" aria-hidden="true"></div>
  <div class="container">
    <div class="roles-inner">
      <div class="roles-text">
        <h2 class="section-title lines">
          <span class="line"><span data-line style="--i:0">Send today.</span></span>
          <span class="line"><span data-line style="--i:1">Carry next month.</span></span>
        </h2>
        <p class="section-subtitle" data-reveal style="--i:3">One verified account. Post a parcel or list spare baggage on a flight you already have.</p>

        <!-- Toggle -->
        <div class="role-toggle" role="radiogroup" aria-label="Choose role view" data-reveal style="--i:4">
          <button
            class="toggle-option is-active"
            role="radio"
            aria-checked="true"
            data-role="sender"
            id="toggle-sender"
          >
            Sending
          </button>
          <button
            class="toggle-option"
            role="radio"
            aria-checked="false"
            data-role="passenger"
            id="toggle-passenger"
          >
            Carrying
          </button>
          <div class="toggle-indicator" id="toggle-indicator" aria-hidden="true"></div>
        </div>
      </div>

      <!-- Phone mockup on a colour field that follows the mode -->
      <div class="roles-phone" data-reveal style="--i:2">
        <div class="phone-field" aria-hidden="true"></div>
        <div class="phone-frame">
          <div class="phone-notch" aria-hidden="true"></div>

          <!-- Sender screen -->
          <div class="phone-screen is-active" id="screen-sender">
            <div class="screen-header">
              <span class="screen-mode-badge sender-badge">Sender mode</span>
            </div>
            <div class="screen-card">
              <div class="screen-card-header">
                <span class="screen-card-label">Active parcel</span>
                <span class="screen-card-status status--ok">Matching</span>
              </div>
              <p class="screen-card-route">Dubai → Rawalpindi</p>
              <p class="screen-card-detail">7.5 kg · Clothes, Confectionery</p>
              <p class="screen-card-detail">Collection: 14–19 Sep</p>
            </div>
            <div class="screen-card screen-card--tint">
              <span class="screen-card-label">Tracking</span>
              <div class="screen-tracking-id">KHP-7F42-9210</div>
            </div>
            <div class="screen-actions">
              <div class="screen-action-btn">View offers</div>
              <div class="screen-action-btn screen-action-btn--soft">Edit parcel</div>
            </div>
          </div>

          <!-- Passenger screen -->
          <div class="phone-screen" id="screen-passenger">
            <div class="screen-header">
              <span class="screen-mode-badge passenger-badge">Passenger mode</span>
            </div>
            <div class="screen-card">
              <div class="screen-card-header">
                <span class="screen-card-label">Active trip</span>
                <span class="screen-card-status status--ok">Listed</span>
              </div>
              <p class="screen-card-route">Dubai → Rawalpindi</p>
              <p class="screen-card-detail">Flight: 17 Sep</p>
              <p class="screen-card-detail">12 kg spare capacity</p>
            </div>
            <div class="screen-card screen-card--tint">
              <div class="screen-card-header">
                <span class="screen-card-label">Matching offers</span>
                <span class="screen-card-count">3</span>
              </div>
              <p class="screen-card-detail">Newest: 7.5 kg · PKR 6,750</p>
            </div>
            <div class="screen-card screen-card--earnings">
              <span class="screen-card-label">Potential earnings</span>
              <div class="screen-earnings-amount">PKR 6,075</div>
              <p class="screen-card-detail">Based on current offers</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .roles-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .roles-inner {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-24);
    }
  }

  .section-title {
    font-size: var(--text-h2);
    letter-spacing: -0.045em;
    line-height: 1;
    margin-bottom: var(--space-6);
  }

  .section-subtitle {
    font-size: var(--text-lg);
    max-width: 24em;
    margin-bottom: var(--space-10);
  }

  /* ── Toggle ────────────────────────────────────────── */
  .role-toggle {
    position: relative;
    display: inline-flex;
    padding: 5px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.12);
  }

  .toggle-option {
    position: relative;
    z-index: 2;
    min-width: 140px;
    min-height: 52px;
    padding: 0 var(--space-6);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: #fff;
    transition: color var(--duration-normal) ease, transform var(--duration-fast) var(--ease-out);
  }
  .toggle-option:active { transform: scale(0.97); }
  .toggle-option.is-active { color: var(--navy); }

  .toggle-indicator {
    position: absolute;
    top: 5px;
    left: 5px;
    width: calc(50% - 5px);
    height: calc(100% - 10px);
    border-radius: var(--radius-full);
    background: #fff;
    transition: transform 360ms var(--ease-drawer);
    z-index: 1;
  }
  .toggle-indicator.is-right { transform: translateX(100%); }

  /* ── Phone ─────────────────────────────────────────── */
  .roles-phone {
    position: relative;
    display: grid;
    place-items: center;
    padding-block: var(--space-6);
  }

  .phone-field {
    position: absolute;
    inset: 0 8% 0 8%;
    border-radius: var(--radius-xl);
    background: var(--kraft);
    transition: background-color 460ms var(--ease-in-out);
  }
  .roles[data-role="passenger"] .phone-field { background: var(--ink-200); }

  .phone-frame {
    position: relative;
    width: var(--phone-width);
    height: 580px;
    margin-block: var(--space-10);
    background: #fff;
    border-radius: 40px;
    overflow: hidden;
    padding: var(--space-6) var(--space-4);
    padding-top: 52px;
    color: var(--text);
  }

  .phone-notch {
    position: absolute;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 28px;
    background: var(--deep);
    border-radius: 20px;
  }

  .phone-screen {
    position: absolute;
    inset: 52px var(--space-4) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    opacity: 0;
    transform: translateX(28px);
    transition:
      opacity var(--duration-normal) ease,
      transform 360ms var(--ease-drawer);
    pointer-events: none;
  }
  .roles[data-role="sender"] #screen-passenger { transform: translateX(28px); }
  .roles[data-role="passenger"] #screen-sender { transform: translateX(-28px); }
  .phone-screen.is-active {
    opacity: 1;
    transform: none !important;
    pointer-events: auto;
    transition-delay: 90ms;
  }

  .screen-header { padding-bottom: var(--space-3); margin-bottom: var(--space-2); }

  .screen-mode-badge {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .sender-badge    { background: var(--kraft); color: var(--deep); }
  .passenger-badge { background: var(--ink-100); color: var(--navy); }

  .screen-card {
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--paper);
  }
  .screen-card--tint { background: var(--ink-50); }
  .screen-card--earnings { background: var(--ok-soft); }

  .screen-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .screen-card-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--text-2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .screen-card-status {
    padding: 2px var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }
  .status--ok { background: var(--ok-soft); color: var(--ok); }

  .screen-card-route {
    margin-bottom: var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--text);
  }

  .screen-card-detail {
    font-size: var(--text-xs);
    color: var(--text-2);
    line-height: var(--leading-relaxed);
  }

  .screen-card-count {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--navy);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
  }

  .screen-tracking-id {
    margin-top: var(--space-2);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--text);
  }

  .screen-earnings-amount {
    margin: var(--space-2) 0;
    font-size: 1.5rem;
    font-weight: var(--weight-extrabold);
    letter-spacing: -0.03em;
    color: var(--ok);
  }

  .screen-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: auto;
  }

  .screen-action-btn {
    padding: var(--space-3);
    border-radius: var(--radius-full);
    background: var(--navy);
    color: #fff;
    text-align: center;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }
  .screen-action-btn--soft { background: var(--ink-50); color: var(--navy); }

  @media (prefers-reduced-motion: reduce) {
    .phone-screen { transform: none !important; }
  }
</style>

<script>
  const root = document.getElementById('sender')!;
  const toggleSender = document.getElementById('toggle-sender')!;
  const togglePassenger = document.getElementById('toggle-passenger')!;
  const indicator = document.getElementById('toggle-indicator')!;
  const screenSender = document.getElementById('screen-sender')!;
  const screenPassenger = document.getElementById('screen-passenger')!;

  function setRole(role: 'sender' | 'passenger') {
    const isSender = role === 'sender';
    root.dataset.role = role;

    toggleSender.classList.toggle('is-active', isSender);
    togglePassenger.classList.toggle('is-active', !isSender);
    toggleSender.setAttribute('aria-checked', String(isSender));
    togglePassenger.setAttribute('aria-checked', String(!isSender));
    indicator.classList.toggle('is-right', !isSender);
    screenSender.classList.toggle('is-active', isSender);
    screenPassenger.classList.toggle('is-active', !isSender);
  }

  toggleSender.addEventListener('click', () => setRole('sender'));
  togglePassenger.addEventListener('click', () => setRole('passenger'));

  // Keyboard support
  [toggleSender, togglePassenger].forEach((btn) => {
    btn.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        setRole('sender');
        toggleSender.focus();
      } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        setRole('passenger');
        togglePassenger.focus();
      }
    });
  });
</script>
