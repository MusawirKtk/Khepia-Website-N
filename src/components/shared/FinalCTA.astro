---
import { withBase } from "../../utils/withBase";
---

<section class="final-cta section section--kraft" id="get-khepia">
  <div class="container">
    <h2 class="cta-headline lines">
      <span class="line"><span data-line style="--i:0">Something to send?</span></span>
      <span class="line"><span data-line style="--i:1">Flying somewhere?</span></span>
    </h2>
    <p class="cta-sub" data-reveal style="--i:3">Verified people. Matching routes. Protected payment.</p>
    <div class="cta-actions" data-reveal style="--i:4">
      <a href={withBase("#sender")} class="btn btn--primary btn--lg">Send a parcel</a>
      <a href={withBase("#carry")} class="btn btn--on-dark btn--lg">Carry & earn</a>
    </div>
    <p class="cta-legal" data-reveal="fade" style="--i:5">
      <a href={withBase("terms")}>Terms</a>
      <span aria-hidden="true">·</span>
      <a href={withBase("privacy")}>Privacy</a>
    </p>
  </div>
</section>

<style>
  .final-cta { padding-block: clamp(88px, 13vw, 200px); }

  .cta-headline {
    font-size: clamp(2.6rem, 9vw, 8.4rem);
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    letter-spacing: -0.02em;
    font-variant-numeric: lining-nums;
    line-height: var(--leading-display);
    color: var(--deep);
    margin-bottom: var(--space-8);
  }

  .cta-sub {
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    color: var(--deep);
    margin-bottom: var(--space-10);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .cta-legal {
    margin-top: var(--space-10);
    display: flex;
    gap: var(--space-3);
    align-items: center;
    font-size: var(--text-sm);
    color: var(--deep);
  }

  .cta-legal a {
    color: var(--deep);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
</style>
