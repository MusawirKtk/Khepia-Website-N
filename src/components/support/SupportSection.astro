---
import { withBase } from "../../utils/withBase";
---

<section class="support section section--soft" id="support">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title lines">
        <span class="line"><span data-line style="--i:0">Need help?</span></span>
        <span class="line"><span data-line style="--i:1">Reach us directly.</span></span>
      </h2>
      <p class="section-subtitle" data-reveal style="--i:3">Email or WhatsApp — same support team.</p>
    </div>

    <div class="support-list">
      <div class="support-row" data-reveal style="--i:0">
        <div class="support-icon support-icon--wa" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/></svg>
        </div>
        <div class="support-copy">
          <h3 class="support-card-title">WhatsApp</h3>
          <p class="support-card-desc">Chat with support.</p>
        </div>
        <a href="https://wa.me/0000000000" class="btn btn--primary" id="whatsapp-support-btn">Message support</a>
      </div>

      <div class="support-row" data-reveal style="--i:1">
        <div class="support-icon" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <div class="support-copy">
          <h3 class="support-card-title">Email</h3>
          <p class="support-card-desc">khepia.pk@gmail.com</p>
        </div>
        <a href="mailto:khepia.pk@gmail.com" class="btn btn--primary" id="email-support-btn">Email support</a>
      </div>
    </div>

    <div class="support-legal" data-reveal>
      <p class="support-legal-lead">Before you register, read:</p>
      <div class="support-legal-links">
        <a href={withBase("terms")}>Terms and Conditions</a>
        <span class="support-legal-sep" aria-hidden="true">·</span>
        <a href={withBase("privacy")}>Privacy Policy</a>
      </div>
    </div>
  </div>
</section>

<style>
  .section-header {
    display: grid;
    gap: var(--space-6);
    margin-bottom: clamp(40px, 6vw, 80px);
  }

  .section-title {
    font-size: var(--text-h2);
    letter-spacing: -0.025em;
    line-height: 1;
    color: var(--navy);
  }

  .section-subtitle { font-size: var(--text-lg); max-width: 20em; }

  @media (min-width: 900px) {
    .section-header {
      grid-template-columns: 1fr auto;
      align-items: end;
      column-gap: var(--space-16);
    }
  }

  /* Contact rows: typographic, separated by a dashed rule */
  .support-list { display: flex; flex-direction: column; }

  .support-row {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-5) var(--space-6);
    padding-block: var(--space-8);
    border-top: 2px dashed var(--ink-200);
  }
  .support-row:last-child { border-bottom: 2px dashed var(--ink-200); }
  .support-row .btn { grid-column: 1 / -1; }

  @media (min-width: 768px) {
    .support-row {
      grid-template-columns: auto 1fr auto;
      gap: var(--space-8);
    }
    .support-row .btn { grid-column: auto; }
  }

  .support-icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--navy);
    color: #fff;
  }
  .support-icon--wa { background: #1fa855; }

  .support-card-title {
    font-size: var(--text-h3);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .support-card-desc {
    font-size: var(--text-lg);
    color: var(--text-2);
    overflow-wrap: anywhere;
  }

  .support-legal {
    margin-top: var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .support-legal-lead { font-size: var(--text-sm); margin: 0; }

  .support-legal-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
  }

  .support-legal-links a {
    color: var(--navy);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    text-decoration-color: var(--kraft-strong);
    white-space: nowrap;
  }

  .support-legal-sep { color: var(--text-2); }
</style>
