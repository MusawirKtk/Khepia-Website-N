---
import { demoParcel, demoTrip } from '../../data/demo';
import { withBase } from '../../utils/withBase';
---

<section class="hero" id="hero">
  <div class="hero-inner container">
    <h1 class="hero-headline lines">
      <span class="line"><span data-line style="--i:0">Send with someone</span></span>
      <span class="line"><span data-line style="--i:1">already going.</span></span>
    </h1>

    <div class="hero-text">
      <p class="hero-sub" data-reveal style="--i:3">
        Khepia matches verified senders with verified travellers already flying between the Gulf and Pakistan.
      </p>
      <p class="hero-trust" data-reveal style="--i:4">
        Verified people. Matching routes. Protected payment. Tracked delivery.
      </p>
      <div class="hero-ctas" data-reveal style="--i:5">
        <a href={withBase("#sender")} class="btn btn--primary btn--lg" id="hero-send-cta">Send a parcel</a>
        <a href={withBase("#carry")} class="btn btn--secondary btn--lg" id="hero-carry-cta">Carry & earn</a>
      </div>
      <p class="hero-corridor" data-reveal="fade" style="--i:6">UAE · Saudi Arabia · Pakistan</p>
    </div>

    <!-- Match stage: parcel ticket + flight ticket, one parcel between them -->
    <div class="hero-stage" id="hero-stage" aria-hidden="true">
      <div class="ticket ticket--parcel" id="hero-sender-card">
        <div class="ticket-main">
          <span class="ticket-badge">Parcel</span>
          <div class="ticket-route">
            <span>{demoParcel.origin}</span>
            <span class="ticket-arrow">→</span>
            <span>{demoParcel.destination}</span>
          </div>
        </div>
        <div class="ticket-stub">
          <span>{demoParcel.collectionWindow}</span>
          <span>{demoParcel.weightKg} kg</span>
        </div>
      </div>

      <div class="parcel-host" id="parcel-host">
        <canvas id="parcel-canvas"></canvas>
        <!-- Plain fallback: replaced by the canvas once WebGL is up -->
        <svg class="parcel-fallback" viewBox="0 0 240 170" fill="none">
          <ellipse cx="120" cy="152" rx="82" ry="10" fill="#1B2158" opacity="0.14"/>
          <rect x="30" y="22" width="180" height="120" rx="14" fill="#F2B04A"/>
          <rect x="106" y="22" width="30" height="120" fill="#D9962F"/>
          <rect x="146" y="82" width="46" height="36" rx="3" fill="#fff"/>
          <rect x="152" y="90" width="30" height="4" rx="2" fill="#1B2158"/>
          <rect x="152" y="100" width="22" height="4" rx="2" fill="#1B2158"/>
        </svg>
      </div>

      <!-- Path ends sit underneath the tickets so the join never shows -->
      <svg class="route-svg" viewBox="0 0 700 460" fill="none">
        <path
          class="route-path"
          d="M 150 70 C 560 60, 150 390, 550 390"
          pathLength="1"
          stroke="#1B2158"
          stroke-width="3"
          stroke-linecap="round"
        />
      </svg>

      <div class="ticket ticket--flight" id="hero-passenger-card">
        <div class="ticket-main">
          <span class="ticket-badge">Flight</span>
          <div class="ticket-route">
            <span>{demoTrip.origin}</span>
            <span class="ticket-arrow">→</span>
            <span>{demoTrip.destination}</span>
          </div>
        </div>
        <div class="ticket-stub">
          <span>{demoTrip.flightDate}</span>
          <span>{demoTrip.spareKg} kg spare</span>
        </div>
      </div>

      <div class="match-chip" id="hero-match-result">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
        Match found
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background-color: var(--white);
    padding-top: calc(var(--header-h) + clamp(32px, 6vw, 72px));
    padding-bottom: clamp(56px, 8vw, 112px);
    overflow: clip;
  }

  .hero-inner {
    display: grid;
    gap: var(--space-10);
    grid-template-columns: 1fr;
  }

  /* ── Headline: the loudest thing on the page ─────────── */
  .hero-headline {
    font-size: clamp(3.05rem, 9.2vw, 8.4rem);
    font-weight: var(--weight-extrabold);
    line-height: var(--leading-display);
    letter-spacing: -0.055em;
    color: var(--navy);
  }

  .hero-sub {
    font-size: var(--text-lg);
    color: var(--text);
    max-width: 30em;
    margin-bottom: var(--space-4);
  }

  .hero-trust {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-2);
    margin-bottom: var(--space-8);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .hero-corridor {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--navy);
  }

  /* ── Stage ───────────────────────────────────────────── */
  .hero-stage {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    position: relative;
  }

  .parcel-host {
    position: relative;
    width: min(100%, 360px);
    aspect-ratio: 4 / 3;
    order: 2;
  }
  .parcel-host canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 500ms ease;
  }
  .parcel-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 400ms ease;
  }
  .hero-stage.is-3d canvas { opacity: 1; }
  .hero-stage.is-3d .parcel-fallback { opacity: 0; }

  .route-svg { display: none; }

  .ticket--parcel { order: 1; rotate: -2deg; }
  .ticket--flight { order: 3; rotate: 2deg; }
  .match-chip { order: 4; }

  /* ── Boarding-pass tickets ───────────────────────────── */
  .ticket {
    position: relative;
    width: min(100%, 300px);
    border-radius: var(--radius-lg);
    z-index: 2;
  }
  .ticket--parcel { background: var(--kraft); color: var(--deep); }
  .ticket--flight { background: var(--navy); color: #fff; }

  .ticket-main { padding: var(--space-5) var(--space-6) var(--space-4); }

  .ticket-badge {
    display: block;
    margin-bottom: var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.72;
  }

  .ticket-route {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-2);
    font-size: var(--text-card);
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .ticket-arrow { font-weight: var(--weight-medium); opacity: 0.6; }

  .ticket-stub {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6) var(--space-5);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    border-top: 2px dashed currentColor;
    border-top-color: color-mix(in srgb, currentColor 30%, transparent);
  }
  /* perforation notches */
  .ticket-stub::before,
  .ticket-stub::after {
    content: '';
    position: absolute;
    top: -11px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--white);
  }
  .ticket-stub::before { left: -10px; }
  .ticket-stub::after  { right: -10px; }

  .match-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-5);
    border-radius: var(--radius-full);
    background: var(--ok);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    z-index: 2;
  }

  /* ── Tablet: ticket · parcel · ticket in one row ─────── */
  @media (min-width: 700px) and (max-width: 1023px) {
    .hero-stage {
      grid-template-columns: repeat(3, 1fr);
      align-items: center;
      gap: var(--space-5);
    }
    .ticket { width: 100%; }
    .parcel-host { width: 100%; order: 2; }
    .ticket--parcel { order: 1; }
    .ticket--flight { order: 3; }
    .match-chip { grid-column: 1 / -1; justify-self: center; }
  }

  /* ── Desktop: free composition ───────────────────────── */
  @media (min-width: 1024px) {
    .hero-inner {
      grid-template-columns: 5fr 7fr;
      column-gap: var(--space-16);
      align-items: end;
    }
    .hero-headline { grid-column: 1 / -1; }

    .hero-stage {
      display: block;
      min-height: 460px;
    }
    .parcel-host {
      position: absolute;
      inset: 0;
      width: auto;
      aspect-ratio: auto;
    }
    .route-svg {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }
    .ticket {
      position: absolute;
      width: 270px;
    }
    .ticket--parcel { top: 0; left: 0; }
    .ticket--flight { bottom: 0; right: 0; }
    .match-chip {
      position: absolute;
      left: 6%;
      bottom: 12%;
    }
  }

  /* ── Entrance: one choreographed sequence ────────────── */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .ticket,
    :global(.js) .match-chip {
      opacity: 0;
      transform: translateY(36px);
    }
    :global(.js) .route-path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
    :global(.js) .hero-stage.is-live .ticket,
    :global(.js) .hero-stage.is-live .match-chip {
      opacity: 1;
      transform: none;
      transition:
        opacity 700ms var(--ease-out),
        transform 900ms var(--ease-out);
    }
    :global(.js) .hero-stage.is-live .ticket--parcel { transition-delay: 500ms; }
    :global(.js) .hero-stage.is-live .ticket--flight { transition-delay: 760ms; }
    :global(.js) .hero-stage.is-live .match-chip { transition-delay: 2000ms; }
    :global(.js) .hero-stage.is-live .route-path {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 1300ms var(--ease-in-out) 1000ms;
    }
  }
</style>

<script>
  const stage = document.getElementById('hero-stage')!;
  const host = document.getElementById('parcel-host')!;
  const canvas = document.getElementById('parcel-canvas') as HTMLCanvasElement;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Tickets, route and chip: start the sequence on the next frame
  requestAnimationFrame(() => requestAnimationFrame(() => stage.classList.add('is-live')));

  // Three.js loads after first paint; if anything fails the plain parcel stays
  const boot = async () => {
    try {
      const { initParcel } = await import('./parcel3d');
      initParcel(canvas, host, reduce);
      stage.classList.add('is-3d');
    } catch {
      /* fallback SVG remains */
    }
  };
  if ('requestIdleCallback' in window) requestIdleCallback(boot, { timeout: 1200 });
  else setTimeout(boot, 300);
</script>
